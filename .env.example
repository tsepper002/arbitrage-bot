# ============================================================================
# Arbitrage Bot Configuration (.env file)
# ============================================================================
# Copy this file to .env and fill in your API keys.
# NEVER commit .env to git — it contains secrets!
#
# Usage:
#   1. Copy:   cp .env.example .env
#   2. Edit:   Fill in your API keys below
#   3. Run:    python main.py --mode dry-run
# ============================================================================

# --- Mode ---
# ARB_DRY_RUN=true          # true = safe simulation, false = live trading

# --- Bybit ---
ARB_BYBIT_KEY=
ARB_BYBIT_SECRET=

# --- KuCoin ---
ARB_KUCOIN_KEY=
ARB_KUCOIN_SECRET=
ARB_KUCOIN_PASSPHRASE=

# --- HTX (Huobi) ---
ARB_HTX_KEY=
ARB_HTX_SECRET=

# --- MEXC ---
ARB_MEXC_KEY=
ARB_MEXC_SECRET=

# --- Binance (optional) ---
# ARB_BINANCE_KEY=
# ARB_BINANCE_SECRET=

# --- Telegram Bot (optional) ---
# ARB_TELEGRAM_TOKEN=
# ARB_TELEGRAM_CHAT_ID=
# ARB_TELEGRAM_ENABLED=true

# --- Risk Limits ---
# ARB_MIN_NET_ROI_PCT=0.05
# ARB_MAX_EXPOSURE_USDT=200.0
# ARB_MAX_DAILY_LOSS=50.0
# ARB_MAX_HOURLY_LOSS=20.0
# ARB_VIRTUAL_CAPITAL_USDT=10000.0

# --- Trading Symbols ---
# ARB_SYMBOLS=BTC-USDT,ETH-USDT,SOL-USDT,BNB-USDT,XRP-USDT,DOGE-USDT,LTC-USDT,ADA-USDT,MATIC-USDT,DOT-USDT
