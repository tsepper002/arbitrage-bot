# ============================================================================
# ARBITRAGE BOT — FULL CONFIGURATION (.env file)
# ============================================================================
# Copy this file to .env and fill in your API keys.
# NEVER commit .env to git!
#
# Usage:
#   1. Copy:   cp .env.example .env  (or: copy .env.example .env  on Windows)
#   2. Edit:   Fill in your API keys below
#   3. Run:    python main.py --mode dry-run
#
# All parameters have safe defaults. Only API keys are required.
# Uncomment and change any parameter to override the default value.
# ============================================================================

# ============================================================================
# EXCHANGE API CREDENTIALS (required for trading)
# ============================================================================

# Bybit
ARB_BYBIT_KEY=
ARB_BYBIT_SECRET=

# KuCoin
ARB_KUCOIN_KEY=
ARB_KUCOIN_SECRET=
ARB_KUCOIN_PASSPHRASE=

# HTX (Huobi)
ARB_HTX_KEY=
ARB_HTX_SECRET=

# MEXC (0% spot trading fees!)
ARB_MEXC_KEY=
ARB_MEXC_SECRET=

# Binance (optional — works without API keys for public data)
# ARB_BINANCE_KEY=
# ARB_BINANCE_SECRET=

# XT (optional)
# ARB_XT_KEY=
# ARB_XT_SECRET=

# ============================================================================
# TELEGRAM NOTIFICATIONS (optional)
# ============================================================================
# ARB_TELEGRAM_TOKEN=
# ARB_TELEGRAM_CHAT_ID=
# ARB_TELEGRAM_ENABLED=true

# ============================================================================
# EXECUTION MODE
# ============================================================================
# true = safe simulation (no real orders), false = LIVE trading
# ARB_DRY_RUN=true

# Virtual capital per exchange for dry-run mode (USDT)
# ARB_VIRTUAL_CAPITAL=20.0

# ============================================================================
# RISK MANAGEMENT
# ============================================================================
# Minimum net ROI % after fees to execute trade (0.02 = aggressive, 0.05 = safe)
# ARB_MIN_NET_ROI_PCT=0.02

# Maximum exposure per single trade (USDT)
# ARB_MAX_EXPOSURE_USDT=300.0

# Safety factor — use only this fraction of available liquidity (0.5 = 50%)
# ARB_SAFETY_FACTOR=0.5

# Maximum trades per minute (rate limit)
# ARB_MAX_TRADES_PER_MINUTE=8

# Cooldown before same symbol can be traded again (seconds)
# ARB_SYMBOL_COOLDOWN_SEC=3.0

# Max concurrent opportunities per scan cycle
# ARB_MAX_CONCURRENT_OPPS=3

# ============================================================================
# MULTI-LAYER RISK LIMITS
# ============================================================================
# Stop trading if daily loss exceeds (USDT)
# ARB_MAX_DAILY_LOSS=50.0

# Pause if hourly loss exceeds (USDT)
# ARB_MAX_HOURLY_LOSS=20.0

# Cancel trade if single trade loss exceeds (USDT)
# ARB_MAX_SINGLE_TRADE_LOSS=15.0

# Max total open position value (USDT)
# ARB_MAX_OPEN_EXPOSURE=500.0

# Pause after N consecutive losses
# ARB_MAX_CONSECUTIVE_LOSSES=5

# Skip spreads above this % (likely anomaly/error)
# ARB_ANOMALOUS_SPREAD_PCT=5.0

# Max data age before trade is rejected (seconds, lower = safer)
# ARB_MAX_DATA_AGE_SEC=0.5

# Minimum balance per exchange to start trading (USDT)
# ARB_MIN_BALANCE_PER_EXCHANGE=8.0

# Minimum trade size to cover fees (USDT)
# ARB_MIN_TRADE_SIZE_USDT=3.0

# Reserve balance per exchange (USDT, not used for trading)
# ARB_BALANCE_RESERVE_USDT=2.0

# Max % of balance to use per trade
# ARB_MAX_BALANCE_USAGE_PCT=75.0

# ============================================================================
# SCANNING & PERFORMANCE
# ============================================================================
# Scan interval in seconds (lower = faster, more CPU)
# ARB_SCAN_INTERVAL_SEC=0.15

# Dashboard update interval (seconds)
# ARB_MONITOR_INTERVAL_SEC=30.0

# Event-driven scanning (only scan on orderbook changes, saves CPU)
# ARB_EVENT_DRIVEN_SCAN=true

# Min time between scans for same symbol (seconds)
# ARB_MIN_SCAN_INTERVAL_PER_SYMBOL=0.1

# ============================================================================
# WEBSOCKET RELIABILITY
# ============================================================================
# Auto-reconnect on disconnect
# ARB_WS_AUTO_RECONNECT=true

# Initial reconnect delay (seconds)
# ARB_WS_RECONNECT_DELAY=5.0

# Max reconnect delay cap (seconds)
# ARB_WS_MAX_RECONNECT_DELAY=300.0

# Backoff multiplier (delay × this after each failure)
# ARB_WS_BACKOFF_MULTIPLIER=2.0

# Max reconnect attempts (0 = unlimited)
# ARB_WS_MAX_RECONNECT_ATTEMPTS=0

# Alert if no WS updates for this many seconds
# ARB_STREAM_STALENESS_SEC=60.0

# Health check interval (seconds)
# ARB_HEALTH_CHECK_INTERVAL=30.0

# ============================================================================
# RESOURCE MONITORING (Windows optimization)
# ============================================================================
# CPU check interval (seconds)
# ARB_CPU_CHECK_INTERVAL=5.0

# Reduce activity above this CPU % threshold
# ARB_CPU_HIGH_THRESHOLD=60.0

# Emergency mode above this CPU %
# ARB_CPU_CRITICAL_THRESHOLD=80.0

# Can increase activity below this CPU %
# ARB_CPU_LOW_THRESHOLD=30.0

# Target max memory usage (MB) — Python + all modules use ~200MB baseline
ARB_MEMORY_MAX_MB=512

# ============================================================================
# AUTO-REBALANCING
# ============================================================================
# Check balance distribution every N seconds
# ARB_REBALANCE_INTERVAL_SEC=1800

# Rebalance if exchange has less than this % of total
# ARB_REBALANCE_MIN_THRESHOLD=0.15

# Source from exchanges with more than this % of total
# ARB_REBALANCE_MAX_THRESHOLD=0.30

# Minimum transfer amount (USDT)
# ARB_REBALANCE_MIN_AMOUNT=50.0

# ============================================================================
# VOLATILITY MONITORING
# ============================================================================
# ATR calculation window (seconds)
# ARB_VOLATILITY_ATR_WINDOW=60

# Calm market threshold
# ARB_VOLATILITY_CALM_THRESHOLD=0.5

# Storm multiplier for volatile markets
# ARB_VOLATILITY_STORM_MULTIPLIER=3.0

# ============================================================================
# FUNDING RATE ARBITRAGE
# ============================================================================
# Enter position at this funding rate %
# ARB_FUNDING_MIN_RATE=0.03

# Exit position at this funding rate %
# ARB_FUNDING_EXIT_RATE=0.01

# Check funding rates every N seconds
# ARB_FUNDING_CHECK_INTERVAL=300

# ============================================================================
# TRIANGULAR ARBITRAGE
# ============================================================================
# Minimum profit % for triangular trade
# ARB_TRIANGULAR_MIN_PROFIT=0.0005

# Enable/disable triangular arbitrage
# ARB_TRIANGULAR_ENABLED=true

# ============================================================================
# STRATEGY MANAGEMENT
# ============================================================================
# Number of trades to track per strategy window
# ARB_STRATEGY_WINDOW=100

# Switch strategy if win rate differs by this %
# ARB_STRATEGY_SWITCH_THRESHOLD=0.1

# ============================================================================
# TRADING SYMBOLS (default: 20 pairs)
# ============================================================================
# Comma-separated, no spaces
# ARB_SYMBOLS=BTC-USDT,ETH-USDT,SOL-USDT,BNB-USDT,XRP-USDT,DOGE-USDT,LTC-USDT,ADA-USDT,MATIC-USDT,DOT-USDT,LINK-USDT,AVAX-USDT,UNI-USDT,ATOM-USDT,FIL-USDT,APT-USDT,ARB-USDT,OP-USDT,TRX-USDT,NEAR-USDT

# Orderbook depth levels to consider
# ARB_ORDERBOOK_TOP_K=20

# Fallback quantity (base asset)
# ARB_DEFAULT_QUANTITY=0.001

# ============================================================================
# LOGGING & PERSISTENCE
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR
# ARB_LOG_LEVEL=INFO

# File paths for data persistence
# ARB_OPPORTUNITIES_CSV=arbs.csv
# ARB_TRADES_CSV=trades.csv
# ARB_STATE_FILE=bot_state.json
# ARB_HEARTBEAT_FILE=heartbeat.txt

# ============================================================================
# FEE REFERENCE (set in core/exchange_config.py, not changeable via .env)
# ============================================================================
# Bybit:   0.10% taker (no VIP, no BYB token discount)
# KuCoin:  0.10% taker (no VIP, no KCS token discount)
# HTX:     0.20% taker (no VIP, no HT token discount)
# MEXC:    0.00% taker (ZERO fees for ALL spot trades!)
# Binance: 0.10% taker (no VIP, no BNB token discount)
# ============================================================================
