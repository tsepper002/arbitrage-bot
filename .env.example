# Arbitrage Bot Configuration (.env file)
# Copy this file to .env and fill in your API keys.
# NEVER commit .env to git!
#
# Usage:
#   1. Copy:   cp .env.example .env  (or: copy .env.example .env)
#   2. Edit:   Fill in your API keys below
#   3. Run:    python main.py --mode dry-run

# Bybit
ARB_BYBIT_KEY=
ARB_BYBIT_SECRET=

# KuCoin
ARB_KUCOIN_KEY=
ARB_KUCOIN_SECRET=
ARB_KUCOIN_PASSPHRASE=

# HTX (Huobi)
ARB_HTX_KEY=
ARB_HTX_SECRET=

# MEXC
ARB_MEXC_KEY=
ARB_MEXC_SECRET=

# Binance (optional)
# ARB_BINANCE_KEY=
# ARB_BINANCE_SECRET=

# Telegram Bot (optional)
# ARB_TELEGRAM_TOKEN=
# ARB_TELEGRAM_CHAT_ID=
# ARB_TELEGRAM_ENABLED=true

# Risk Limits (optional, defaults shown)
# ARB_MIN_NET_ROI_PCT=0.05
# ARB_MAX_EXPOSURE_USDT=200.0
# ARB_MAX_DAILY_LOSS=50.0
# ARB_MAX_HOURLY_LOSS=20.0
# ARB_VIRTUAL_CAPITAL=1000.0

# Trading Symbols (default: 20 pairs)
# ARB_SYMBOLS=BTC-USDT,ETH-USDT,SOL-USDT,BNB-USDT,XRP-USDT,DOGE-USDT,LTC-USDT,ADA-USDT,MATIC-USDT,DOT-USDT,LINK-USDT,AVAX-USDT,UNI-USDT,ATOM-USDT,FIL-USDT,APT-USDT,ARB-USDT,OP-USDT,TRX-USDT,NEAR-USDT

# Fee Notes (for reference, set in core/exchange_config.py):
# Bybit:  0.10% taker (no VIP, no BYB)
# KuCoin: 0.10% taker (no VIP, no KCS)
# HTX:    0.20% taker (no VIP, no HT)
# MEXC:   0.00% taker (ZERO fees for all spot trades!)
# Binance: 0.10% taker (no VIP, no BNB)
