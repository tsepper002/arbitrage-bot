# ============================================================================
# RISK MANAGEMENT
# ============================================================================
ARB_MIN_NET_ROI_PCT=0.05              # Minimum profit percentage after fees
ARB_MAX_EXPOSURE_USDT=200.0           # Maximum USD per trade
ARB_SAFETY_FACTOR=0.5                 # Use 50% of available liquidity
ARB_MAX_TRADES_PER_MINUTE=5           # Rate limiting
ARB_SYMBOL_COOLDOWN_SEC=5.0           # Seconds between trades per symbol (reduced from 30)
ARB_MAX_CONCURRENT_OPPS=3             # Max opportunities to process simultaneously

# Risk Limits
ARB_MAX_DAILY_LOSS=50.0               # Stop trading if daily loss exceeds this
ARB_MAX_SINGLE_TRADE_LOSS=15.0        # Cancel trade if loss exceeds this
ARB_MAX_HOURLY_LOSS=20.0              # Pause if hourly loss exceeds this
ARB_MAX_OPEN_EXPOSURE=500.0           # Maximum total open position value
ARB_MAX_CONSECUTIVE_LOSSES=5          # Pause after this many losses in a row
ARB_ANOMALOUS_SPREAD_PCT=5.0          # Skip spreads above this (likely data error)
ARB_MAX_DATA_AGE_SEC=3.0              # Don't trade on data older than this
ARB_MIN_BALANCE_PER_EXCHANGE=20.0     # Minimum balance to keep trading on exchange

# ============================================================================
# PERFORMANCE & SCANNING
# ============================================================================
ARB_SCAN_INTERVAL_SEC=0.5             # Reduced from 1.0 for faster scanning
ARB_MONITOR_INTERVAL_SEC=5.0          # How often to print monitoring info
ARB_EVENT_DRIVEN_SCAN=true            # Scan immediately when orderbook updates
ARB_MIN_SCAN_INTERVAL_PER_SYMBOL=0.1  # Minimum time between scans per symbol
ARB_ORDERBOOK_TOP_K=20                # Number of orderbook levels to analyze

# ============================================================================
# WEBSOCKET RELIABILITY
# ============================================================================
ARB_WS_AUTO_RECONNECT=true            # Auto-reconnect on disconnect
ARB_WS_RECONNECT_DELAY=5.0            # Initial reconnect delay
ARB_WS_MAX_RECONNECT_DELAY=300.0      # Max reconnect delay (5 minutes)
ARB_WS_BACKOFF_MULTIPLIER=2.0         # Exponential backoff multiplier
ARB_WS_MAX_RECONNECT_ATTEMPTS=0       # 0 = unlimited attempts
ARB_STREAM_STALENESS_SEC=60.0         # Alert if no updates for this long
ARB_HEALTH_CHECK_INTERVAL=30.0        # Health check frequency

# ============================================================================
# VOLATILITY MONITORING (Strategy S4)
# ============================================================================
ARB_VOLATILITY_ATR_WINDOW=60          # ATR calculation window in seconds
ARB_VOLATILITY_CALM_THRESHOLD=0.5     # Threshold for calm market
ARB_VOLATILITY_STORM_MULTIPLIER=3.0   # Multiplier for storm mode

# ============================================================================
# AUTO-REBALANCING
# ============================================================================
ARB_REBALANCE_INTERVAL_SEC=1800       # Check every 30 minutes
ARB_REBALANCE_MIN_THRESHOLD=0.15      # Rebalance if exchange has <15% of total
ARB_REBALANCE_MAX_THRESHOLD=0.30      # Take from exchanges with >30%
ARB_REBALANCE_MIN_AMOUNT=50.0         # Minimum amount to transfer

# ============================================================================
# RESOURCE MONITORING (Windows 11 Optimization)
# ============================================================================
ARB_CPU_CHECK_INTERVAL=5.0            # Check CPU/RAM every 5 seconds
ARB_CPU_HIGH_THRESHOLD=60.0           # Reduce activity above 60% CPU
ARB_CPU_CRITICAL_THRESHOLD=80.0       # Emergency mode above 80% CPU
ARB_CPU_LOW_THRESHOLD=30.0            # Can increase activity below 30% CPU
ARB_MEMORY_MAX_MB=200                 # Target max memory usage

# ============================================================================
# TRADING SYMBOLS
# ============================================================================
ARB_SYMBOLS=BTC-USDT,ETH-USDT,SOL-USDT,BNB-USDT,XRP-USDT,DOGE-USDT,LTC-USDT,ADA-USDT,MATIC-USDT,DOT-USDT

# ============================================================================
# LOGGING & PERSISTENCE
# ============================================================================
ARB_LOG_LEVEL=INFO                    # DEBUG, INFO, WARNING, ERROR
ARB_OPPORTUNITIES_CSV=arbs.csv        # File to log opportunities
ARB_TRADES_CSV=trades.csv             # File to log executed trades
ARB_STATE_FILE=bot_state.json         # Persistent state file
ARB_HEARTBEAT_FILE=heartbeat.txt      # Watchdog heartbeat file

# ============================================================================
# FUNDING RATE ARBITRAGE (Strategy S3)
# ============================================================================
ARB_FUNDING_MIN_RATE=0.03             # Minimum funding rate to enter (0.03%)
ARB_FUNDING_EXIT_RATE=0.01            # Exit when funding drops below this
ARB_FUNDING_CHECK_INTERVAL=300        # Check funding rates every 5 minutes

# ============================================================================
# TRIANGULAR ARBITRAGE (Strategy S2)
# ============================================================================
ARB_TRIANGULAR_MIN_PROFIT=0.0005      # Minimum profit (0.05%) for triangular arb
ARB_TRIANGULAR_ENABLED=true           # Enable triangular arbitrage

# ============================================================================
# STRATEGY MANAGEMENT
# ============================================================================
ARB_STRATEGY_WINDOW=100               # Number of trades to track per strategy
ARB_STRATEGY_SWITCH_THRESHOLD=0.1     # Switch strategies if performance differs by 10%
